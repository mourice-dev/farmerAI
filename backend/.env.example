# FarmerAI Backend — copy to .env and adjust

# ─── Groq API (Free, fast LPU cloud — recommended) ───────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# ─── DeepSeek (cloud alternative) ────────────────────────────────
# DEEPSEEK_API_KEY=your-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ─── Generic aliases (optional — override provider-specific vars):
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ─── Ollama (local, no key required) ─────────────────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ─── Tests only — NEVER enable in production ─────────────────────
# MOCK_LLM=1

# ─── CORS (optional, comma-separated origins; default * in dev) ──
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
